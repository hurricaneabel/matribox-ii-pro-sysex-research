{
  "$schema": "../schemas/value-codec.schema.json",
  "schema_version": 1,
  "key": "upper_float32_nibbles_v1",
  "kind": "float32_upper_16_bits_as_nibbles",
  "encoded_length": 4,
  "description": "Seleciona os quatro nibbles superiores do payload float32 completo e reconstrói um float32 little-endian com bytes inferiores 00 00.",
  "configuration": {
    "byte_order": "little_endian",
    "lower_bytes": [
      0,
      0
    ],
    "nibble_order": "high_then_low_per_byte",
    "require_finite": true,
    "integer_tolerance": 1e-06,
    "input_slice": [
      4,
      8
    ]
  }
}
